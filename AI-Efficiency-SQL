-- Makes a table for all of the low severity incidents sortby increasing date
CREATE TABLE quarterly_incidents_low AS
SELECT i.deployment_id,  DATE(d.deployment_date) AS deployment_date, i.severity, i.resolution_time_hours
FROM incidents i
LEFT JOIN deployments d
ON i.deployment_id = d.deployment_id
WHERE i.severity = 'Low'
ORDER BY d.deployment_date;

-- Makes a table for all of the medium severity incidents sortby increasing date
CREATE TABLE quarterly_incidents_meduim AS
