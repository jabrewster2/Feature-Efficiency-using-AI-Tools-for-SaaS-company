-- Makes a table for what the engineers are using AI for
CREATE TABLE ai_engineering_tasks AS
SELECT task_type, COUNT(task_type) AS `task_count`
FROM ai_usage
GROUP BY task_type
ORDER BY COUNT(task_type) DESC;

-- Makes a table for the number of features released per quarter
CREATE TABLE features_per_quarter AS
SELECT
	complexity,
	COUNT(CASE WHEN release_date BETWEEN '2025-01-01' AND '2025-03-31' THEN 1 END) AS `features added (Q1)`,
	COUNT(CASE WHEN release_date BETWEEN '2025-04-01' AND '2025-06-30' THEN 1 END) AS `features added (Q2)`,
	COUNT(CASE WHEN release_date BETWEEN '2025-07-01' AND '2025-09-30' THEN 1 END) AS `features added (Q3)`,
	COUNT(CASE WHEN release_date BETWEEN '2025-10-01' AND '2025-12-31' THEN 1 END) AS `features added (Q4)`,
    COUNT(complexity) as `yearly features added`
FROM features
group by complexity
ORDER BY
	CASE complexity
		WHEN 'Large' THEN 1
        WHEN 'Medium' THEN 2
        WHEN 'Small' THEN 3
        ELSE 4
END;

-- Makes a table for the number of pull requests made by seniority per quarter
CREATE TABLE seniority_merged_per_quarter AS
SELECT 
	d.seniority_level, 
	COUNT(CASE WHEN pr.merged_at BETWEEN '2025-01-01' AND '2025-03-31' THEN pr.developer_id END) AS `merge count (Q1)`,
	COUNT(CASE WHEN pr.merged_at BETWEEN '2025-04-01' AND '2025-06-30' THEN pr.developer_id END) AS `merge count (Q2)`,
	COUNT(CASE WHEN pr.merged_at BETWEEN '2025-07-01' AND '2025-09-30' THEN pr.developer_id END) AS `merge count (Q3)`,
	COUNT(CASE WHEN pr.merged_at BETWEEN '2025-10-01' AND '2025-12-31' THEN pr.developer_id END) AS `merge count (Q4)`,
    COUNT(pr.merged_at) as `total merge count`
    
FROM developers d
LEFT JOIN pull_requests pr
ON d.developer_id = pr.developer_id
GROUP BY d.seniority_level
ORDER BY
	CASE d.seniority_level
		WHEN 'Senior' THEN 1
        WHEN 'Mid' THEN 2
        WHEN 'Entry' THEN 3
        ELSE 4
END;

-- Creates a table for the number of incidents per serverity level and their avgerate resolultion time per quarter
CREATE TABLE incidents_per_quarter AS
SELECT
	i.severity,

	COUNT(CASE WHEN d.deployment_date BETWEEN '2025-01-01' AND '2025-03-31' THEN 1 END) AS `incident_count_(Q1)`,
	ROUND(AVG(CASE WHEN d.deployment_date BETWEEN '2025-01-01' AND '2025-03-31' THEN i.resolution_time_hours END), 2) AS `avg_resolution_time_(Q1)`,

	COUNT(CASE WHEN d.deployment_date BETWEEN '2025-04-01' AND '2025-06-30' THEN 1 END) AS `incident_count_(Q2)`,
	ROUND(AVG(CASE WHEN d.deployment_date BETWEEN '2025-04-01' AND '2025-06-30' THEN i.resolution_time_hours END), 2) AS `avg_resolution_time_(Q2)`,

	COUNT(CASE WHEN d.deployment_date BETWEEN '2025-07-01' AND '2025-09-30' THEN 1 END) AS `incident_count_(Q3)`,
	ROUND(AVG(CASE WHEN d.deployment_date BETWEEN '2025-07-01' AND '2025-09-30' THEN i.resolution_time_hours END), 2) AS `avg_resolution_time_(Q3)`,

	COUNT(CASE WHEN d.deployment_date BETWEEN '2025-10-01' AND '2025-12-31' THEN 1 END) AS `incident_count_(Q4)`,
	ROUND(AVG(CASE WHEN d.deployment_date BETWEEN '2025-10-01' AND '2025-12-31' THEN i.resolution_time_hours END), 2) AS `avg_resolution_time_(Q4)`,
    
    count(i.severity) AS `year_incident_count`, 
    ROUND(AVG(i.resolution_time_hours), 2) AS `year_avg_resolution_time`
    
FROM incidents i
LEFT JOIN deployments d
ON i.deployment_id = d.deployment_id
WHERE d.deployment_date BETWEEN '2025-01-01' AND '2025-12-31'
GROUP BY i.severity
ORDER BY
  CASE i.severity
    WHEN 'High' THEN 1
    WHEN 'Medium' THEN 2
    WHEN 'Low' THEN 3
    ELSE 4
  END;
  
